<!-- Regras do SOC Home Lab — API Node (lab-api). Faixa 100100–100199 -->
<group name="lab-api,">

  <!-- Base: qualquer evento JSON vindo da lab-api (nível 0 = não alerta sozinha) -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^lab-api$</field>
    <description>Lab API: evento da aplicação</description>
  </rule>

  <!-- Falha de login isolada: baixa severidade, sem MITRE (errar a senha 1x é normal) -->
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^login_failure$</field>
    <description>Lab API: falha de login do usuário $(dstuser) a partir de $(src_ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Login bem-sucedido: informativo, útil para correlação -->
  <rule id="100102" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^login_success$</field>
    <description>Lab API: login bem-sucedido de $(dstuser) a partir de $(src_ip)</description>
    <group>authentication_success,</group>
  </rule>

  <!-- Token JWT inválido ou adulterado -->
  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^auth_invalid_token$</field>
    <description>Lab API: requisição com token JWT inválido em $(path) a partir de $(src_ip)</description>
    <group>authentication_failed,</group>
  </rule>

</group>

<group name="lab-api,">

  <!-- Força bruta: 5+ falhas de login do MESMO IP em 60 segundos -->
  <rule id="100110" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Lab API: possível força bruta — múltiplas falhas de login a partir de $(src_ip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,attack,</group>
  </rule>

</group>

<group name="lab-api,access_control,">

  <!-- Pedido inexistente (404): base para detectar enumeração -->
  <rule id="100104" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^order_not_found$</field>
    <description>Lab API: $(dstuser) pediu um pedido inexistente ($(order_id))</description>
  </rule>

  <!-- IDOR: usuário acessou pedido de OUTRO usuário (OWASP A01 / CWE-639) -->
  <rule id="100120" level="10">
    <if_sid>100100</if_sid>
    <field name="event">^order_access$</field>
    <field name="cross_user">^true$</field>
    <description>Lab API: $(dstuser) acessou o pedido $(order_id) de outro usuário ($(resource_owner)) — possível IDOR</description>
    <group>idor,owasp_a01,</group>
  </rule>

  <!-- Enumeração: 3+ pedidos inexistentes do MESMO usuário em 60 s -->
  <rule id="100121" level="8" frequency="3" timeframe="60">
    <if_matched_sid>100104</if_matched_sid>
    <same_user />
    <description>Lab API: possível enumeração de IDs por $(dstuser) — múltiplos pedidos inexistentes</description>
    <group>idor,enumeration,owasp_a01,</group>
  </rule>

</group>
