<!-- Regras do SOC Home Lab — API Node (lab-api). Faixa 100100–100199 -->
<group name="lab-api,">

  <!-- Base: qualquer evento JSON vindo da lab-api (nível 0 = não alerta sozinha) -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^lab-api$</field>
    <description>Lab API: evento da aplicação</description>
  </rule>

  <!-- Falha de login isolada: baixa severidade, sem MITRE (errar a senha 1x é normal) -->
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^login_failure$</field>
    <description>Lab API: falha de login do usuário $(dstuser) a partir de $(src_ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Login bem-sucedido: informativo, útil para correlação -->
  <rule id="100102" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^login_success$</field>
    <description>Lab API: login bem-sucedido de $(dstuser) a partir de $(src_ip)</description>
    <group>authentication_success,</group>
  </rule>

  <!-- Token JWT inválido ou adulterado -->
  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^auth_invalid_token$</field>
    <description>Lab API: requisição com token JWT inválido em $(path) a partir de $(src_ip)</description>
    <group>authentication_failed,</group>
  </rule>

</group>
